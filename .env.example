# Local device/emulator development (optional; Expo detects LAN host automatically)
# EXPO_PUBLIC_API_HOST=192.168.1.10

# Production / EAS builds (required for store builds)
EXPO_PUBLIC_API_URL=https://api.sessly.pl

# Public website hosting privacy/terms
EXPO_PUBLIC_WEB_URL=https://sessly.pl
EXPO_PUBLIC_PRIVACY_URL=https://sessly.pl/privacy
EXPO_PUBLIC_TERMS_URL=https://sessly.pl/terms
EXPO_PUBLIC_SUPPORT_EMAIL=support@sessly.pl

# Set true only after SMS provider (Twilio) is configured on the API
EXPO_PUBLIC_PHONE_VERIFY_ENABLED=false

# Customer deposits — keep false until marketplace payouts are legally ready
EXPO_PUBLIC_CUSTOMER_DEPOSITS_ENABLED=false

# EAS project id (npx eas init) — required for Expo Push in store builds
EXPO_PUBLIC_EAS_PROJECT_ID=

# Maps: OpenStreetMap in-app (no Google Maps billing). Geocoding = Nominatim on API.

# RevenueCat public SDK keys (App Store / Play subscriptions)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=location_access
